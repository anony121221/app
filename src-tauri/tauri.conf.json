{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RadarApp",
  "version": "0.2.1",
  "identifier": "com.radar.nexrad",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NEXRAD Radar",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/radar_backend.exe",
      "../nwws-backend/"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
