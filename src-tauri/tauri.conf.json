{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RadarApp",
  "version": "0.1.1",
  "identifier": "com.radar.nexrad",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NEXRAD Radar",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "../nwws-backend/",
      "updater-endpoint.txt"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEQzBCNDBFN0UwMDBFMjAKUldRZ0RnQitEclRBWFovYzVDdjVuZ1ZCS2pFdHNJQXEzOFo1bUluRVdZeURRQThXRVRtcGIxeHgK",
      "endpoints": [
        "https://github.com/anony121221/app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
